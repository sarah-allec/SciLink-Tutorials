# Rename this file to ".env" and paste your Amazon Bedrock API key below.
# The workshop organizer hands you this key -- it is a single bearer token,
# no IAM users or `aws configure` needed.

AWS_BEARER_TOKEN_BEDROCK=paste-your-bedrock-api-key-here

# The AWS region where the key was issued (and where the model is enabled).
# If the organizer does not say otherwise, leave this as us-east-1.
AWS_REGION=us-east-1
